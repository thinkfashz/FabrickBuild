{
  "name": "fabrickbuild",
  "version": "2.0.0",
  "private": true,
  "description": "FabrickBuild — CMS, CRM y frontend para Soluciones Fabrick.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:code-only": "next build",
    "build:with-assets": "npm run assets:luxury && next build",
    "start": "next start",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "assets:luxury": "node src/scripts/materializeLuxuryFrames.mjs",
    "bootstrap:auto": "payload run src/scripts/autoBootstrap.ts",
    "bootstrap:vercel": "cross-env AUTO_BOOTSTRAP=true payload run src/scripts/autoBootstrap.ts",
    "seed": "payload run src/seed.ts",
    "db:push": "cross-env NODE_ENV=development tsx src/scripts/pushSchema.ts",
    "db:sync:vercel": "cross-env NODE_ENV=development tsx src/scripts/pushSchema.ts",
    "setup": "npm run db:push && npm run seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@vercel/blob": "^2.6.1",
    "animejs": "4.5.0",
    "cross-env": "10.1.0",
    "fast-uri": "3.1.4",
    "graphql": "16.11.0",
    "gsap": "3.13.0",
    "lucide-react": "0.563.0",
    "next": "16.2.11",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.179.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "typescript": "6.0.3",
    "tsx": "4.22.4"
  },
  "engines": {
    "node": "24.x"
  }
}
