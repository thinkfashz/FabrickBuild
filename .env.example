# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# Payload
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-different-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Opcional. Si no existe, las credenciales de integraciones se cifran con una clave derivada de PAYLOAD_SECRET.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-dedicated-secret-of-at-least-32-characters

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Instalación web única. BOOTSTRAP_SECRET es opcional; si falta se usa SEED_SECRET.
BOOTSTRAP_SECRET=
SEED_SECRET=replace-with-another-long-random-secret
ADMIN_EMAIL=admin@solucionesfabrick.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-16-characters
