{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "ignoreCommand": "node -e \"const message=process.env.VERCEL_GIT_COMMIT_MESSAGE||'';const ref=process.env.VERCEL_GIT_COMMIT_REF||'';process.exit(/\\[skip ci\\]/i.test(message)||ref==='agent/complete-cms-performance'?0:1)\"",
  "regions": ["iad1"]
}
